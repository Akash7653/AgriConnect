# Server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/agriconnect
JWT_SECRET=replace_with_a_long_random_secret
SEED_PASSWORD=replace_with_a_random_local_development_password
CLIENT_URL=http://localhost:3000
GROK_API_KEY=your_server_side_xai_api_key
GROK_MODEL=grok-3-mini

# Razorpay server credentials
RAZORPAY_KEY_ID=your_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_matching_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Server-side geocoding
GEOCODING_PROVIDER=nominatim
APP_BASE_URL=http://localhost:5000

# Optional product-image CDN. With all three values unset, uploads use MongoDB GridFS.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# OTP email delivery (Brevo is the default; use a verified sender)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=verification@example.com
EMAIL_FROM_NAME=AgriConnect
# For EMAIL_PROVIDER=resend, provide a verified-domain sender and API key.
RESEND_API_KEY=re_your_server_api_key
