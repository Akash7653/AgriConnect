# ==========================================
# AgriConnect Platform Configuration (2026)
# ==========================================

PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Atlas Cluster or In-memory fallback if left blank)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# JWT Secret
JWT_SECRET=replace_with_at_least_32_random_characters
SEED_PASSWORD=replace_with_a_random_local_development_password

# Razorpay credentials (test for development; live required in production)
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
GEOCODING_PROVIDER=nominatim
APP_BASE_URL=http://localhost:5000
