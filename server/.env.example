# ==========================================
# AgriConnect Platform Configuration (2026)
# ==========================================

PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Atlas Cluster or In-memory fallback if left blank)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# JWT Secret
JWT_SECRET=replace_with_at_least_32_random_characters
SEED_PASSWORD=replace_with_a_random_local_development_password

# Razorpay credentials (test for development; live required in production)
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
STOREFRONT_CAMPAIGNS_JSON=[]
GEOCODING_PROVIDER=nominatim
APP_BASE_URL=http://localhost:5000
GEOCODING_CONTACT_EMAIL=
RESEND_API_KEY=re_your_server_api_key
# Must be an address on a domain verified in Resend before production delivery.
RESEND_FROM_EMAIL=AgriConnect <onboarding@your-verified-domain.example>
# Frontend origin used to construct account-verification links.
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
XAI_API_KEY=your_server_side_xai_api_key
XAI_MODEL=grok-4.7
# Enable only after Razorpay Route is active and test transfers are verified.
RAZORPAY_ROUTE_ENABLED=false
